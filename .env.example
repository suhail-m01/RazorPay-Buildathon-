# --- Core ---
ENVIRONMENT=dev
# Local default: SQLite. Production/Compose: postgresql+asyncpg://recoverpay:recoverpay@postgres:5432/recoverpay
DATABASE_URL=sqlite+aiosqlite:///./recoverpay.db
JWT_SECRET=change-me-to-a-long-random-string

# --- Redis (optional; in-process fallback when empty) ---
REDIS_URL=

# --- Razorpay (test mode). Empty => in-app test checkout using the SAME capture path. ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Channels: Resend (email) + Twilio (SMS/WhatsApp). Empty => queued/simulated. ---
RESEND_API_KEY=
EMAIL_FROM=RecoverPay <billing@recoverpay.ai>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_SMS=
TWILIO_FROM_WHATSAPP=whatsapp:+17372508034
TWILIO_WHATSAPP_CONTENT_SID=
TWILIO_WHATSAPP_CONTENT_VARIABLES_JSON=
TWILIO_VOICE_FROM=+17372508034
TWILIO_VOICE_TO=+919380962272
PUBLIC_BASE_URL=

# --- LLM (optional; deterministic taxonomy/templates otherwise) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=

# --- Live demo contacts: seeded with is_demo_contact=true (the ONLY rows that can dispatch real sends).
#     Either set DEMO_CONTACTS_JSON here, or copy scripts/demo_contacts.example.py -> scripts/demo_contacts.py
#     (gitignored) with real details. NEVER commit real PII.
FOUNDER_EMAIL=syedsuhailm786@gmail.com
FOUNDER_PHONE=+919380962272
# DEMO_CONTACTS_JSON=[{"name":"You","email":"you@gmail.com","phone":"+9198xx","language":"en-IN","case_type":"payment_failed"}]

# --- Scheduler ---
AUTO_TICK=true
TICK_INTERVAL_MINUTES=5

# --- CORS (explicit origins only) ---
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Vonage Messages API Sandbox — WhatsApp
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY_PATH=./private.key
VONAGE_WHATSAPP_FROM=
VONAGE_WHATSAPP_TO=
VONAGE_VOICE_FROM=
VONAGE_VOICE_TO=
